# python generate_hash.py <비밀번호> 출력값을 붙여넣으세요 ($는 $$로 이스케이프됨)
ADMIN_PASSWORD_HASH=
# 아무 긴 랜덤 문자열 (예: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET_KEY=
# Cloudflare Tunnel(HTTPS)로 접속할 때는 true
COOKIE_SECURE=true
# 텔레그램 알림 (@BotFather에서 받은 봇 토큰). chat_id는 대시보드 설정 화면에서 지정
TELEGRAM_BOT_TOKEN=
# 알림 링크에 쓰는 대시보드 주소
PUBLIC_URL=https://rsi.example.com
