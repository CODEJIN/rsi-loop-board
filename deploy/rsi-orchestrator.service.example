# ~/.config/systemd/user/rsi-orchestrator.service 로 복사한 뒤 경로를 맞추세요.
#   systemctl --user daemon-reload && systemctl --user enable --now rsi-orchestrator
#   (로그아웃 후에도 돌게 하려면: sudo loginctl enable-linger $USER)
[Unit]
Description=RSI Loop orchestrator (dashboard command queue → loop.py)
After=default.target

[Service]
Type=simple
WorkingDirectory=/path/to/rsi-loop-board/phase0
ExecStart=/usr/bin/python3 /path/to/rsi-loop-board/phase0/orchestrator.py
# claude CLI, PyYAML이 있는 python, docker가 PATH에 있어야 합니다.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/path/to/rsi-loop-board/phase0/orchestrator.log
StandardError=inherit
Restart=on-failure
RestartSec=5
# 루프는 별도 세션으로 띄우므로 서비스 재시작 시 같이 죽지 않게 합니다(오케스트레이터가 다시 찾아 관리).
KillMode=process

[Install]
WantedBy=default.target
